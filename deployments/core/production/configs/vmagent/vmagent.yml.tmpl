global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:
  # node_exporter on every k8s node (the node-exporter DaemonSet, host network so the pod IP is
  # the node's). instance is the node name, e.g. prx-001-srv-prod-core-worker-001.
  - job_name: node
    metrics_path: /metrics
    scheme: http
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names: ["${K8S_NAMESPACE}"]
        selectors:
          - role: pod
            label: "app.kubernetes.io/name=node-exporter"
    relabel_configs:
      - source_labels: [__meta_kubernetes_pod_ip]
        target_label: __address__
        replacement: "$1:${NODE_EXPORTER_PORT}"
      - source_labels: [__meta_kubernetes_pod_node_name]
        target_label: instance

  # node_exporter installed by iac-homelab's monitoring playbook on the management VMs.
  - job_name: node-mgmt
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets:
          - "prx-001-srv-mgmt-001.${DOMAIN}:9100"
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance
        replacement: "$1"
      - target_label: job
        replacement: node

  # Every Vault node (stack-vault), metrics are unauthenticated. Sealed nodes are scraped too.
  - job_name: "vault"
    metrics_path: /v1/sys/metrics
    params:
      format: ["prometheus"]
    scheme: https
    tls_config:
      insecure_skip_verify: true
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names: ["vault-core"]
        selectors:
          - role: pod
            label: "app.kubernetes.io/name=vault"
    relabel_configs:
      - source_labels: [__meta_kubernetes_pod_container_port_name]
        regex: https
        action: keep
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: instance

  - job_name: "rabbitmq"
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets:
          - "rabbitmq-broker.rabbitmq-core.svc:15692"
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
